---
layout: base.njk
title: Max Bergmann - Engineering Portfolio
headerLabel: Project Portfolio
showWireframe: true
---

<!-- ───────────────────────── Hero ───────────────────────── -->
<section class="min-h-[80vh] md:min-h-[85vh] flex flex-col justify-center py-12 md:py-0">
  <div class="space-y-6" data-reveal data-reveal-dir="up">
    <p class="font-mono text-xs md:text-sm tracking-[0.25em] uppercase text-primary mb-2">
      Software Engineer / Johannesburg
    </p>
    <h1 class="text-6xl md:text-8xl lg:text-[9rem] font-bold leading-[0.85] tracking-tight -ml-1 md:-ml-2 text-slate-900 dark:text-white">
      Max Bergmann
    </h1>
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mt-4 border-t border-slate-200 dark:border-slate-800 pt-8">
      <h2 class="text-lg md:text-2xl font-medium tracking-wide text-slate-500 dark:text-slate-400 uppercase max-w-xs">
        {{ site.role }}
      </h2>
      <div class="max-w-2xl text-base md:text-xl lg:text-2xl leading-relaxed font-light text-slate-600 dark:text-slate-200">
        <p>
          <span class="text-primary font-normal">Software engineering student</span> who enjoys building things that actually do something. Drawn to practical projects and picking up new tools — exploring <span class="text-primary font-normal">Qt, OpenGL, and C</span>.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────── Section divider / scroll cue ─────────────────── -->
<div class="flex items-center gap-4 text-text-dim font-mono text-xs uppercase tracking-widest py-8 md:py-12" data-reveal data-reveal-dir="scale">
  <span class="h-px flex-1 bg-slate-800"></span>
  <span>Scroll</span>
  <span class="h-px flex-1 bg-slate-800"></span>
</div>

<!-- ───────────────────────── Projects ───────────────────────── -->
<section class="py-20 md:py-32">
  <div class="flex items-center gap-4 mb-12" data-reveal data-reveal-dir="left">
    <span class="h-px w-8 bg-primary"></span>
    <h3 class="text-sm font-bold tracking-[0.2em] text-primary uppercase">Project Outlines</h3>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
    {% for project in projects %}
      <div data-reveal data-reveal-dir="{{ 'left' if loop.index0 % 2 == 0 else 'right' }}" style="--reveal-delay: {{ loop.index0 * 80 }}ms">
        {% include "project-card.njk" %}
      </div>
    {% endfor %}
  </div>
</section>

<!-- ───────────────────────── Closing / contact teaser ───────────────────────── -->
<section class="py-20 md:py-32 border-t border-slate-200 dark:border-slate-800">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8" data-reveal data-reveal-dir="scale">
    <div>
      <p class="font-mono text-xs tracking-[0.25em] uppercase text-primary mb-3">Get in touch</p>
      <h3 class="text-3xl md:text-5xl font-bold text-slate-900 dark:text-white max-w-xl leading-tight">
        Always interested in practical problems worth solving.
      </h3>
    </div>
    <a href="mailto:{{ site.social.email }}" class="shrink-0 inline-flex items-center gap-2 bg-primary text-white font-bold px-6 py-3.5 rounded-lg hover:bg-blue-600 transition-colors">
      Email me
      <span class="material-symbols-outlined text-base">arrow_forward</span>
    </a>
  </div>
</section>
